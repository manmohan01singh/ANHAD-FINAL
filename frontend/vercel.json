{
  "buildCommand": null,
  "installCommand": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "no-cache, no-store" }
      ]
    }
  ],
  "functions": {
    "api/stream.js": {
      "runtime": "edge"
    }
  }
}
