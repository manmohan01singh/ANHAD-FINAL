{
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/admin", "destination": "/Admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/Admin/$1" },
    { "source": "/api/(.*)", "destination": "https://anhad-final.onrender.com/api/$1" },
    { "source": "/goal", "destination": "/Dashboard/dashboard.html" },
    { "source": "/boost", "destination": "/NitnemTracker/nitnem-tracker.html" },
    { "source": "/teamwork-preview", "destination": "/sangat/friends.html" },
    { "source": "/companion", "destination": "/Companion/companion.html" },
    { "source": "/insights", "destination": "/Insights/insights.html" }
  ],
  "headers": [

    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-admin-token, x-admin-pin, x-session-token" },
        { "key": "Cache-Control", "value": "no-cache, no-store" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
