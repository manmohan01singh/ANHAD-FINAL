# ═══════════════════════════════════════════════════════════
# ANHAD Backend Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# Cloudflare R2 Audio Storage
R2_BASE_URL=https://pub-525228169e0c44e38a67c306ba1a458c.r2.dev

# CORS — comma-separated allowed origins
# For production on Render, add your Vercel domain:
# ALLOWED_ORIGINS=https://anhadnaam.vercel.app,capacitor://localhost,ionic://localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# ═══════════════════════════════════════════════════════════
# Firebase Admin SDK Configuration (Production-Grade Auth)
# ═══════════════════════════════════════════════════════════
# Strategy A: File path to downloaded Service Account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Strategy B: Direct environment variables (ideal for Render/Vercel/Heroku)
FIREBASE_PROJECT_ID=anhad-4bf78
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@anhad-4bf78.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, copy the exact private_key string including BEGIN/END lines.
# Replace newlines with \n if placing on a single line in cloud host dashboards.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web Client API Key (from Firebase Console -> Project Settings -> Web App)
# Used by frontend web clients for Google Sign-In and email authentication.
FIREBASE_WEB_API_KEY=AIzaSy...

# Admin API token — REQUIRED for timing-safe server-to-server admin authentication:
#   /api/sadhsangat/admin/*   (channel management)
#   /api/config/admin/*       (campaign config: read, preview, publish, toggle)
#   /api/admin/live-now       (Who Is Live Now dashboard)
# Without this or a verified Firebase admin custom claim, admin routes return 401/403.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send it from admin client as header: X-Admin-Token: <value>
ADMIN_API_TOKEN=

# ═══════════════════════════════════════════════════════════
# Campaign config storage
# ═══════════════════════════════════════════════════════════
# Set ALL THREE to store the campaign config in Cloudflare KV. Leave them blank
# and it falls back to a JSON file under backend/data/ — which works fine
# locally but is LOST ON EVERY RESTART on an ephemeral filesystem like Render,
# so an admin toggle would silently revert. The server logs which backend is
# active at startup.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# Optional: override where the file backend writes (defaults to backend/data/campaign-config.json)
# CONFIG_STORE_FILE=./data/campaign-config.json
