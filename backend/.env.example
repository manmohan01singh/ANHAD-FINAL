# ═══════════════════════════════════════════════════════════
# ANHAD Backend Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# Cloudflare R2 Audio Storage
R2_BASE_URL=https://pub-525228169e0c44e38a67c306ba1a458c.r2.dev

# CORS — comma-separated allowed origins
# For production on Render, add your Vercel domain:
# ALLOWED_ORIGINS=https://anhadnaam.vercel.app,capacitor://localhost,ionic://localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost

# File Paths (optional - defaults work for most deployments)
# FRONTEND_ROOT=../frontend
# MAIN_UI=../frontend
# SEHAJ_PROGRESS_DIR=./data/sehaj-progress
# RADIO_STATE_FILE=./radio-state.json

# Radio Configuration (optional - defaults are fine)
# DEFAULT_TRACK_DURATION=3600
# LISTENER_TTL=60000
# STATE_SAVE_INTERVAL=30000

# Admin API token — REQUIRED for BOTH admin surfaces:
#   /api/sadhsangat/admin/*   (channel management)
#   /api/config/admin/*       (campaign config: read, preview, publish, toggle)
# Without this set, those routes fail closed with 503.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send it from the admin client as header: X-Admin-Token: <value>
ADMIN_API_TOKEN=

# ═══════════════════════════════════════════════════════════
# Campaign config storage
# ═══════════════════════════════════════════════════════════
# Set ALL THREE to store the campaign config in Cloudflare KV. Leave them blank
# and it falls back to a JSON file under backend/data/ — which works fine
# locally but is LOST ON EVERY RESTART on an ephemeral filesystem like Render,
# so an admin toggle would silently revert. The server logs which backend is
# active at startup.
#
# No Cloudflare Worker deployment is needed — this talks to the KV REST API.
# Create a namespace in the Cloudflare dashboard (Workers & Pages > KV), then
# create an API token with the "Workers KV Storage: Edit" permission.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# Optional: override where the file backend writes (defaults to backend/data/campaign-config.json)
# CONFIG_STORE_FILE=./data/campaign-config.json
