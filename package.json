{
    "name": "gurbani-radio",
    "version": "3.9.4",
    "description": "24/7 Divine Gurbani Kirtan streaming with reminders and Nitnem Tracker",
    "main": "electron-main.js",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "node backend/server.js",
        "build": "node scripts/generate-version.js",
        "optimize:images": "node scripts/optimize-images.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:jest": "jest",
        "test:jest:watch": "jest --watch",
        "test:jest:coverage": "jest --coverage",
        "electron": "electron .",
        "electron:dev": "electron . --dev",
        "electron:build": "npm run build && electron-builder --win",
        "electron:build:all": "npm run build && electron-builder --win --mac --linux",
        "cap:init": "npx cap init \"Gurbani Radio\" \"com.gurbaniradio.app\" --web-dir frontend",
        "cap:add:android": "npx cap add android",
        "cap:sync": "npm run build && npx cap sync",
        "cap:open:android": "npx cap open android",
        "cap:build": "npm run build && npm run cap:sync && npx cap open android"
    },
    "keywords": [
        "gurbani",
        "sikh",
        "kirtan",
        "pwa",
        "nitnem",
        "electron"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@capacitor-community/native-audio": "^6.0.0",
        "@capacitor/android": "^6.2.1",
        "@capacitor/app": "^6.0.3",
        "@capacitor/cli": "^6.2.1",
        "@capacitor/core": "^6.2.1",
        "@capacitor/filesystem": "^6.0.4",
        "@capacitor/haptics": "^6.0.3",
        "@capacitor/local-notifications": "^6.1.3",
        "@capacitor/splash-screen": "^6.0.4",
        "@capacitor/status-bar": "^6.0.3",
        "@ybouane/liquidglass": "^1.0.3",
        "compression": "^1.8.1",
        "dotenv": "^16.0.0",
        "express": "^4.18.2",
        "express-rate-limit": "^7.0.0",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/ios": "^6.2.1",
        "@fast-check/jest": "^2.2.0",
        "@testing-library/dom": "^10.4.1",
        "@types/jest": "^30.0.0",
        "@vitest/ui": "^4.1.10",
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3",
        "fast-check": "^4.9.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jsdom": "^29.1.1",
        "lighthouse": "^13.4.0",
        "patch-package": "^8.0.1",
        "typescript": "^5.0.0",
        "vitest": "^4.1.10"
    },
    "build": {
        "appId": "com.gurbaniradio.desktop",
        "productName": "Gurbani Radio",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "electron-main.js",
            "electron-preload.js",
            "frontend/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "frontend/nitnem/icons/icon-512.png",
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Gurbani Radio",
            "include": null,
            "installerIcon": "frontend/nitnem/icons/icon-512.png",
            "uninstallerIcon": "frontend/nitnem/icons/icon-512.png"
        },
        "portable": {
            "artifactName": "GurbaniRadio-Portable.exe"
        }
    }
}
