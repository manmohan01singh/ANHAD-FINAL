<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for local development and all domains for audio streaming -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Explicit domain config for audio CDNs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">r2.dev</domain>
        <domain includeSubdomains="true">onrender.com</domain>
        <domain includeSubdomains="true">sgpc.net</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
