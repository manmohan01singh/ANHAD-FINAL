<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Material You-inspired premium widget background -->
    <corners android:radius="24dp" />

    <!-- Rich gradient background -->
    <gradient
        android:angle="145"
        android:startColor="#1E1E2E"
        android:centerColor="#181825"
        android:endColor="#11111B"
        android:type="linear" />

    <!-- Subtle luminous border -->
    <stroke
        android:width="1dp"
        android:color="#22FFFFFF" />

</shape>
