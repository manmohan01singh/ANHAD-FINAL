<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Daily Hukamnama Sahib Widget (Sacred Royal Gold & Glass Design) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hukamnama_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_parchment_dark"
    android:padding="16dp">

    <!-- Header: Sacred Khanda + Title + Ang Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☬"
            android:textSize="14sp"
            android:textColor="#F59E0B"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/hukamnama_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ਅੱਜ ਦਾ ਮੁੱਖਵਾਕ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FCD34D" />

        <!-- Ang Badge Pill -->
        <TextView
            android:id="@+id/hukamnama_ang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ਅੰਗ ੬੮੪"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

    <!-- Source / Date Subtitle -->
    <TextView
        android:id="@+id/hukamnama_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ਸੱਚਖੰਡ ਸ੍ਰੀ ਹਰਿਮੰਦਰ ਸਾਹਿਬ"
        android:textSize="10sp"
        android:textColor="#80FFFFFF"
        android:layout_marginTop="3dp" />

    <!-- Sacred Mukhwak Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inner"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <!-- Gurmukhi Verse -->
        <TextView
            android:id="@+id/hukamnama_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ਸੋਰਠਿ ਮਹਲਾ ੫ ॥ ਗਏ ਕਲੇਸ ਰੋਗ ਸਭਿ ਨਾਸੇ ਪ੍ਰਭਿ ਅਪੁਨੈ ਕਿਰਪਾ ਧਾਰੀ ॥"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFDF5"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Affordance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Hukamnama Sahib"
            android:textSize="9sp"
            android:textColor="#80FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read Full &amp; Audio →"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

</LinearLayout>
