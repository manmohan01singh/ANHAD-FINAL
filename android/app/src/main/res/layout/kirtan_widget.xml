<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Live Kirtan Widget (Apple Music / Spotify iOS Glassmorphism) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kirtan_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_glass"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Cover Art Frame with Live Badge & Equalizer -->
    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginEnd="14dp">

        <!-- Album Cover -->
        <ImageView
            android:id="@+id/kirtan_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/artwork_darbar"
            android:background="@drawable/widget_card_inner"
            android:contentDescription="Sri Harmandir Sahib Ji" />

        <!-- Glowing LIVE Badge (top-right) -->
        <TextView
            android:id="@+id/kirtan_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_badge_live"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="● LIVE"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Equalizer Bars (bottom-center) -->
        <LinearLayout
            android:id="@+id/kirtan_equalizer"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:visibility="gone">
            <View android:layout_width="3dp" android:layout_height="6dp" android:background="#F59E0B" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#FCD34D" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="10dp" android:background="#F59E0B" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="16dp" android:background="#FCD34D" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="8dp" android:background="#F59E0B"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Info & Controls (Right Section) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Category Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☬  LIVE GURBANI KIRTAN"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#CCF59E0B"
            android:letterSpacing="0.1"
            android:layout_marginBottom="3dp" />

        <!-- Track Title -->
        <TextView
            android:id="@+id/kirtan_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Darbar Sahib Live"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Station / Subtitle -->
        <TextView
            android:id="@+id/kirtan_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sri Harmandir Sahib Ji"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- Play / Pause Button -->
            <FrameLayout
                android:id="@+id/kirtan_play_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_action_button_bg">

                <TextView
                    android:id="@+id/kirtan_play_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="▶"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0B0C12"
                    android:gravity="center" />
            </FrameLayout>

            <!-- Status text -->
            <TextView
                android:id="@+id/kirtan_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap to listen"
                android:textSize="11sp"
                android:textColor="#99FFFFFF"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
