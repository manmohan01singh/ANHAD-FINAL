<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Darbar Sahib Live Kirtan Widget (Spotify-style horizontal layout) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kirtan_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@drawable/widget_bg_kirtan"
    android:gravity="center_vertical">

    <!-- Cover Art Section -->
    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginEnd="14dp">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/kirtan_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/circle_accent_bg"
            android:contentDescription="Darbar Sahib" />

        <!-- LIVE Badge (top-right corner) -->
        <TextView
            android:id="@+id/kirtan_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/live_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="● LIVE"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Equalizer Bars (bottom-center, shown when playing) -->
        <LinearLayout
            android:id="@+id/kirtan_equalizer"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <View android:layout_width="3dp" android:layout_height="6dp" android:background="#E8A838" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#F5D47A" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="10dp" android:background="#E8A838" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="16dp" android:background="#F5D47A" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="8dp" android:background="#E8A838"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Track Info + Controls (right side) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <!-- App Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☬  ANHAD"
            android:textSize="9sp"
            android:textColor="#80E8A838"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <!-- Track Name -->
        <TextView
            android:id="@+id/kirtan_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Darbar Sahib Live"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Station Name -->
        <TextView
            android:id="@+id/kirtan_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sri Harmandir Sahib Ji"
            android:textSize="12sp"
            android:textColor="#99FFFFFF"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <!-- Play/Pause Button -->
            <FrameLayout
                android:id="@+id/kirtan_play_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/play_button_bg">

                <TextView
                    android:id="@+id/kirtan_play_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="▶"
                    android:textSize="15sp"
                    android:textColor="#0a0a0a"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

            <!-- Duration / Status Text -->
            <TextView
                android:id="@+id/kirtan_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to play"
                android:textSize="10sp"
                android:textColor="#66FFFFFF"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
