<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Sangat Notifications & Friend Requests Widget (iOS Glassmorphism) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="16dp">

    <!-- Header: Title + Notification Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔  SANGAT ACTIVITY"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CCF59E0B" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/reminder_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Sangat Active"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

    <!-- Main Activity Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inner"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sangat Notifications"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/reminder_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Friend requests &amp; companion updates"
            android:textSize="12sp"
            android:textColor="#CCFFFFFF"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/reminder_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to view friend requests &amp; connect"
            android:textSize="10sp"
            android:textColor="#80FFFFFF"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Companion Sangat Network"
            android:textSize="10sp"
            android:textColor="#80FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Sangat →"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#B3FFFFFF" />
    </LinearLayout>

</LinearLayout>
