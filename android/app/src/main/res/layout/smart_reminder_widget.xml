<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰"
            android:textSize="18sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/reminder_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smart Reminders"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/reminder_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#B3FFFFFF" />
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/reminder_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No reminders set"
        android:textSize="13sp"
        android:textColor="#B3FFFFFF"
        android:layout_marginBottom="6dp" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/reminder_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_orange"
        android:layout_marginBottom="8dp" />

    <!-- Next reminder -->
    <TextView
        android:id="@+id/reminder_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#FF9500"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
