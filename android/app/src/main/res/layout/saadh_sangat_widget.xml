<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Saadh Sangat Live Widget (iOS Broadcast Glassmorphism) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sadhsangat_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="16dp">

    <!-- Header: Title + LIVE Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡  SAADH SANGAT LIVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CCF59E0B"
            android:letterSpacing="0.1" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Glowing LIVE Pill -->
        <TextView
            android:id="@+id/sadhsangat_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/widget_badge_live"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="● LIVE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </LinearLayout>

    <!-- Main Broadcast Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inner"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sadhsangat_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saadh Sangat Live Broadcast"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sadhsangat_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Gurbani Kirtan Samagam"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Listeners Count Pill -->
        <TextView
            android:id="@+id/sadhsangat_listeners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_glass"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="👥 1,240 Sangat Listening"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FCD34D"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Bottom Controls & Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <FrameLayout
            android:id="@+id/sadhsangat_play_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_action_button_bg">

            <TextView
                android:id="@+id/sadhsangat_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="▶"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0B0C12"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/sadhsangat_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap to listen live"
            android:textSize="11sp"
            android:textColor="#99FFFFFF"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join Live →"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

</LinearLayout>
