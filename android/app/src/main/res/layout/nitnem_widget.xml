<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Nitnem Tracker Widget (iOS Glassmorphism Design) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nitnem_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="16dp">

    <!-- Header: Title + Amritvela Streak Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☬  NITNEM TRACKER"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CCF59E0B"
            android:letterSpacing="0.12" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Amritvela / Nitnem Streak Pill -->
        <TextView
            android:id="@+id/nitnem_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🔥 0 Days"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

    <!-- Progress Status & Percentage Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/nitnem_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 of 5 Banis Completed"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/nitnem_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FCD34D" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/nitnem_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_progress_gold"
        android:max="100"
        android:progress="0" />

    <!-- Card: Pending Banis Section -->
    <LinearLayout
        android:id="@+id/nitnem_pending_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inner"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nitnem_pending_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Pending Banis:"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#B3FFFFFF"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/nitnem_pending_banis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Japji Sahib, Jaap Sahib, Tav-Prasad..."
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Bottom Row: Indicators + Read Affordance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/nitnem_bani_indicators"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="○ ○ ○ ○ ○"
            android:textSize="11sp"
            android:textColor="#80F59E0B"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read Nitnem →"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#B3FFFFFF" />
    </LinearLayout>

</LinearLayout>
