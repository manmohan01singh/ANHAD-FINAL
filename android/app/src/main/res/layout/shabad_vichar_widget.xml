<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Shabad Vichar Widget (Apple Books iOS Contemplation Glassmorphism) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shabad_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="16dp">

    <!-- Header: Title + Ang/Author Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖  ਸ਼ਬਦ ਵਿਚਾਰ • SHABAD VICHAR"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CCF59E0B"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/shabad_author_ang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Ang 12"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

    <!-- Contemplation Verse Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inner"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- Gurmukhi Verse -->
        <TextView
            android:id="@+id/shabad_gurmukhi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ਗੁਰ ਪਰਸਾਦੀ ਵਿਦਿਆ ਵੀਚਾਰੈ ਪਰਉਪਕਾਰੀ ਹੋਵੈ ॥"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFDF5"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- English Translation / Meaning -->
        <TextView
            android:id="@+id/shabad_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By Guru's Grace one contemplates spiritual wisdom, and becomes a benefactor to all."
            android:textSize="11sp"
            android:textColor="#CCFFFFFF"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Affordance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/shabad_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Divine Contemplation"
            android:textSize="9sp"
            android:textColor="#80FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contemplate →"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

</LinearLayout>
