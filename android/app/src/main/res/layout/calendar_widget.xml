<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Gurpurab Sikh Calendar Widget (iOS Glassmorphism Design) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="16dp">

    <!-- Header: Title + Nanakshahi Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☬  GURPURAB CALENDAR"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CCF59E0B" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/calendar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nanakshahi Calendar"
            android:textSize="10sp"
            android:textColor="#B3FFFFFF" />
    </LinearLayout>

    <!-- Main Event Countdown Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/widget_card_inner"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- Countdown Number Pill -->
        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:background="@drawable/widget_pill_gold"
            android:gravity="center">

            <TextView
                android:id="@+id/calendar_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FCD34D"
                android:gravity="center" />

            <TextView
                android:id="@+id/calendar_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAYS"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#F59E0B" />
        </LinearLayout>

        <!-- Event Details (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPCOMING GURPURAB"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#80FFFFFF" />

            <TextView
                android:id="@+id/calendar_event_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parkash Sri Guru Nanak Dev Ji"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/calendar_event_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historic Celebration"
                android:textSize="11sp"
                android:textColor="#CCF59E0B"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Affordance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/calendar_hukamnama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap to view upcoming Sikh events"
            android:textSize="10sp"
            android:textColor="#80FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calendar →"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#B3FFFFFF" />
    </LinearLayout>

</LinearLayout>
