<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Amritvela Kirtan Widget (Midnight Celestial Dawn iOS Glassmorphism) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amritvela_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_celestial"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Cover Art Frame with Moon Badge & Equalizer -->
    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginEnd="14dp">

        <!-- Cover Art — emoji-based (RemoteViews safe) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌅"
                android:textSize="30sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Celestial Moon Badge (top-right) -->
        <TextView
            android:id="@+id/amritvela_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_pill_glass"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="🌙"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <!-- Equalizer Bars (bottom-center) -->
        <LinearLayout
            android:id="@+id/amritvela_equalizer"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:visibility="gone">
            <View android:layout_width="3dp" android:layout_height="6dp" android:background="#818CF8" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#A5B4FC" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="10dp" android:background="#818CF8" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="16dp" android:background="#A5B4FC" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="8dp" android:background="#818CF8"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Info & Controls (Right Section) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Category Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌅  AMRITVELA KIRTAN"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#B3818CF8"
            android:letterSpacing="0.1"
            android:layout_marginBottom="3dp" />

        <!-- Track Title -->
        <TextView
            android:id="@+id/amritvela_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amritvela Kirtan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Station / Subtitle -->
        <TextView
            android:id="@+id/amritvela_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24/7 Divine Kirtan"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- Play / Pause Button -->
            <FrameLayout
                android:id="@+id/amritvela_play_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_action_button_bg">

                <TextView
                    android:id="@+id/amritvela_play_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="▶"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0B0C12"
                    android:gravity="center" />
            </FrameLayout>

            <!-- Streak / Counter text -->
            <TextView
                android:id="@+id/amritvela_track_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Amritvela 24/7"
                android:textSize="11sp"
                android:textColor="#A5B4FC"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
