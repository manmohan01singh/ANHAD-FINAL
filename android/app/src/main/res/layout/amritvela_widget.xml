<?xml version="1.0" encoding="utf-8"?>
<!-- ANHAD — Amritvela Kirtan Widget (Spotify-style horizontal, night theme) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amritvela_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@drawable/widget_bg_amritvela"
    android:gravity="center_vertical">

    <!-- Cover Art Section -->
    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginEnd="14dp">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/amritvela_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/amritvela_circle_bg"
            android:contentDescription="Amritvela Kirtan" />

        <!-- Moon Badge (top-right corner) -->
        <TextView
            android:id="@+id/amritvela_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/amritvela_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🌙"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <!-- Equalizer Bars (bottom-center, shown when playing) -->
        <LinearLayout
            android:id="@+id/amritvela_equalizer"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <View android:layout_width="3dp" android:layout_height="6dp" android:background="#FF6B35" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="14dp" android:background="#FFA564" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="10dp" android:background="#FF6B35" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="16dp" android:background="#FFA564" android:layout_marginEnd="2dp"/>
            <View android:layout_width="3dp" android:layout_height="8dp" android:background="#FF6B35"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Track Info + Controls (right side) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <!-- App Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌅  AMRITVELA"
            android:textSize="9sp"
            android:textColor="#80FF6B35"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <!-- Track Name -->
        <TextView
            android:id="@+id/amritvela_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amritvela Kirtan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Station Name -->
        <TextView
            android:id="@+id/amritvela_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24/7 Divine Kirtan"
            android:textSize="12sp"
            android:textColor="#99FFFFFF"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <!-- Play/Pause Button -->
            <FrameLayout
                android:id="@+id/amritvela_play_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/amritvela_play_button_bg">

                <TextView
                    android:id="@+id/amritvela_play_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="▶"
                    android:textSize="15sp"
                    android:textColor="#0a0a0a"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

            <!-- Track Counter -->
            <TextView
                android:id="@+id/amritvela_track_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track 1 of 40"
                android:textSize="10sp"
                android:textColor="#66FFFFFF"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
