<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ੴ"
            android:textSize="56sp"
            android:textColor="#FFB347"
            android:layout_marginBottom="4dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ਵਾਹਿਗੁਰੂ"
            android:textSize="38sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ਨਾਮ ਅਭਿਆਸ | Naam Abhyas"
            android:textSize="24sp"
            android:textColor="#FFB347"
            android:layout_marginBottom="8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ਸਬ ਕੰਮ ਛੱਡੋ, ਵਾਹਿਗੁਰੂ ਜੀ ਦਾ ਸਿਮਰਨ ਕਰੋ\nLeave all work. Remember Vaheguru."
            android:textSize="16sp"
            android:textColor="#DDDDDD"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#FFB347"
            android:textColor="#000000"
            android:text="🙏 Start Simran (2 min)"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReading"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#2E2315"
            android:textColor="#FFB347"
            android:text="📖 Sacred Reading &amp; Simran"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#1F1F28"
            android:textColor="#BBBBBB"
            android:text="Skip For Now"
            android:textSize="15sp" />

    </LinearLayout>

</RelativeLayout>
