{
	"appId": "com.anhad.app",
	"appName": "Anhad",
	"webDir": "frontend",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#020205"
	},
	"plugins": {
		"LocalNotifications": {
			"smallIcon": "ic_stat_notify",
			"iconColor": "#f7c634",
			"sound": "notification.wav"
		},
		"StreakSaverPlugin": {},
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#020205",
			"showSpinner": true,
			"spinnerColor": "#f7c634",
			"androidSpinnerStyle": "small",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP"
		},
		"WidgetDataBridge": {
			"updateInterval": 15,
			"debug": false
		},
		"CapacitorHttp": {
			"enabled": false
		}
	},
	"packageClassList": [
		"NativeAudio",
		"AppPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
